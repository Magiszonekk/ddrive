generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id           String          @id @default(cuid())
  email        String          @unique
  username     String?         @unique
  passwordHash String
  createdAt    DateTime        @default(now())
  files        File[]
  folders      Folder[]
  blobs        BlobTransport[]
  shares       Share[]
  sessions     DeviceSession[]
  apiKeys      ApiKey[]
}

model DeviceSession {
  id               String    @id @default(cuid())
  userId           String
  deviceName       String?
  refreshTokenHash String    @unique
  createdAt        DateTime  @default(now())
  lastUsedAt       DateTime  @default(now())
  expiresAt        DateTime
  revokedAt        DateTime?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, revokedAt])
}

model ApiKey {
  id         String    @id @default(cuid())
  userId     String
  name       String
  keyHash    String    @unique
  prefix     String
  createdAt  DateTime  @default(now())
  lastUsedAt DateTime?
  expiresAt  DateTime?
  revokedAt  DateTime?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, revokedAt])
}

model File {
  id                    String      @id @default(cuid())
  ownerUserId           String
  parentFolderId        String?
  name                  String?
  mimeType              String?
  primaryManifestBlobId String?
  previewBlobId         String?
  thumbnailBlobId       String?
  posterBlobId          String?
  status                FileStatus  @default(UPLOADING)
  totalBytes            BigInt      @default(0)
  chunkCount            Int         @default(0)
  createdAt             DateTime    @default(now())
  updatedAt             DateTime    @updatedAt
  deletedAt             DateTime?

  owner        User     @relation(fields: [ownerUserId], references: [id], onDelete: Cascade)
  parentFolder Folder?  @relation(fields: [parentFolderId], references: [id], onDelete: SetNull)
  shares       Share[]

  @@index([ownerUserId, parentFolderId, status])
  @@index([ownerUserId, deletedAt])
}

enum FileStatus {
  UPLOADING
  READY
  FAILED
}

enum BlobStorageKind {
  LOCAL
  DISCORD
  TELEGRAM
}

model BlobTransport {
  blobId               String           @id
  ownerUserId          String
  storageKind          BlobStorageKind
  storagePath          String
  discordMessageId     String?
  discordChannelId     String?
  webhookId            String?
  sizeBytes            BigInt
  contentHash          String?
  healthStatus         BlobHealthStatus?
  healthCheckedAt      DateTime?
  createdAt            DateTime         @default(now())

  owner      User            @relation(fields: [ownerUserId], references: [id], onDelete: Cascade)
  placements BlobPlacement[]

  @@index([ownerUserId, createdAt])
}

model BlobPlacement {
  id              String          @id @default(cuid())
  blobId          String
  provider        BlobStorageKind
  poolRole        PoolRole
  status          PlacementStatus
  storagePath     String
  messageId       String?
  locationId      String?
  senderId        String?
  attemptCount    Int             @default(0)
  lastError       String?
  nextAttemptAt   DateTime?
  createdAt       DateTime        @default(now())
  activatedAt     DateTime?
  healthCheckedAt DateTime?

  blob BlobTransport @relation(fields: [blobId], references: [blobId], onDelete: Cascade)

  @@unique([blobId, provider, poolRole])
  @@index([blobId, poolRole, status])
  @@index([status, createdAt])
}

enum PoolRole {
  PRIMARY
  REPLICA
}

enum PlacementStatus {
  PENDING
  ACTIVE
  MISSING
  MODIFIED
  DELETING
}

enum BlobHealthStatus {
  HEALTHY
  MISSING
  MODIFIED
}

model Folder {
  id             String    @id @default(cuid())
  ownerUserId    String
  parentFolderId String?
  name           String
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  owner        User     @relation(fields: [ownerUserId], references: [id], onDelete: Cascade)
  parent       Folder?  @relation("FolderTree", fields: [parentFolderId], references: [id], onDelete: SetNull)
  childFolders Folder[] @relation("FolderTree")
  files        File[]

  @@index([ownerUserId, parentFolderId])
}

model Share {
  shareId      String      @id @default(cuid())
  ownerUserId  String
  fileId       String
  shareType    ShareType   @default(FILE)
  tokenHash    String      @unique
  allowContent Boolean     @default(true)
  allowPreview Boolean     @default(false)
  status       ShareStatus @default(ACTIVE)
  expiresAt    DateTime?
  maxViews     Int?
  viewCount    Int         @default(0)
  createdAt    DateTime    @default(now())
  revokedAt    DateTime?

  owner User @relation(fields: [ownerUserId], references: [id], onDelete: Cascade)
  file  File @relation(fields: [fileId], references: [id], onDelete: Cascade)

  @@index([ownerUserId, status])
  @@index([expiresAt])
  @@index([fileId])
}

enum ShareType {
  FILE
}

enum ShareStatus {
  ACTIVE
  REVOKED
  EXPIRED
}
